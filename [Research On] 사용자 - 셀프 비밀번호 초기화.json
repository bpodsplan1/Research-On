    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\n\nconst userId = String(body.user_id || '').trim();\nconst name = String(body.name || '').trim();\nconst email = String(body.email || '').trim();\n\nif (!userId || !name || !email) {\n  throw new Error('아이디, 성명, 이메일을 모두 입력해주세요.');\n}\n\nreturn [{ json: { user_id: userId, name, email } }];"
      },
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "U1. Code - 입력 검증",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://aiftpranlfudkbobxyll.supabase.co/rest/v1/profiles",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "user_id", "value": "=eq.{{ $json.user_id }}"},
            {"name": "name", "value": "=eq.{{ $json.name }}"},
            {"name": "email", "value": "=eq.{{ $json.email }}"},
            {"name": "select", "value": "id"}
          ]
        },
        "options": {}
      },
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "U2. HTTP Request - profiles 일치 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "emV7HjmG16pBRr4q",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(x => x.json || {});\nconst matchedId = rows.length === 1 ? rows[0].id : null;\nreturn [{ json: { matched_id: matchedId } }];"
      },
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "U3. Code - 매칭 결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://aiftpranlfudkbobxyll.supabase.co/auth/v1/admin/users/{{ $json.matched_id || '00000000-0000-0000-0000-000000000000' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ password: 'dlxmsjtm1!' }) }}",
        "options": {}
      },
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "U4. HTTP Request - Supabase Auth 비밀번호 초기화",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
