      "position": [0, 0],
      "webhookId": "user-self-reset-password"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\n\nconst userId = String(body.user_id || '').trim();\nconst name = String(body.name || '').trim();\nconst email = String(body.email || '').trim();\n\nif (!userId || !name || !email) {\n  throw new Error('아이디, 성명, 이메일을 모두 입력해주세요.');\n}\n\nreturn [{ json: { user_id: userId, name, email } }];"
      },
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "U1. Code - 입력 검증",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://aiftpranlfudkbobxyll.supabase.co/rest/v1/profiles",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "user_id", "value": "=eq.{{ $json.user_id }}"},
            {"name": "select", "value": "id,name,email"}
          ]
        },
        "options": {}
      },
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "U2. HTTP Request - profiles 일치 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "emV7HjmG16pBRr4q",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(x => x.json || {});\nconst input = $('U1. Code - 입력 검증').first().json;\nconst profile = rows.length === 1 ? rows[0] : null;\n\nif (!profile) {\n  return [{ json: { matched: false, id_exists: false, mismatch_fields: [], matched_id: '' } }];\n}\n\nconst mismatches = [];\nif (String(profile.name || '').trim() !== input.name) mismatches.push('성명');\nif (String(profile.email || '').trim() !== input.email) mismatches.push('이메일');\n\nreturn [{ json: {\n  matched: mismatches.length === 0,\n  id_exists: true,\n  mismatch_fields: mismatches,\n  matched_id: mismatches.length === 0 ? profile.id : ''\n} }];"
      },
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "U3. Code - 매칭 결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.matched }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b0000000-0000-4000-8000-000000000008",
      "name": "U4. IF - 일치하는 계정 존재",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://aiftpranlfudkbobxyll.supabase.co/auth/v1/admin/users/{{ $json.matched_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ password: 'dlxmsjtm1!' }) }}",
        "options": {}
      },
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "U5. HTTP Request - Supabase Auth 비밀번호 초기화",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "emV7HjmG16pBRr4q",
          "name": "Supabase"
        }
      },
      "continueOnFail": true,
      "notes": "일치하는 계정이 확인된 경우에만 호출됨(U4 IF에서 이미 걸러짐). 인증: Supabase 크리덴셜(apikey 헤더, secret 키) 연결 필요."
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst raw = items.length ? (items[0].json || {}) : {};\nconst failed = !!raw.error;\nif (failed) {\n  const detail = raw.error && (raw.error.message || JSON.stringify(raw.error));\n  return [{ json: { success: false, message: '비밀번호 초기화 중 오류가 발생했습니다: ' + String(detail || '알 수 없는 오류').slice(0, 300) } }];\n}\nreturn [{ json: { success: true, message: '비밀번호가 초기화되었습니다.' } }];"
      },
      "id": "b0000000-0000-4000-8000-000000000006",
      "name": "U6. Code - 성공 응답 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, -120]
    },
    {
      "parameters": {
        "jsCode": "const prep = $('U3. Code - 매칭 결과 정리').first().json;\nlet message;\nif (!prep.id_exists) {\n  message = '입력하신 아이디를 찾을 수 없습니다.';\n} else {\n  const fields = prep.mismatch_fields || [];\n  message = fields.join('·') + '이(가) 입력하신 아이디와 일치하지 않습니다.';\n}\nreturn [{ json: { success: false, message } }];"
      },
      "id": "b0000000-0000-4000-8000-000000000009",
